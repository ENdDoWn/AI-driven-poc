{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Version1: Frontend dev",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}/Version1/frontend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Version1: Backend dev",
      "type": "shell",
      "command": "../../.venv/bin/python -m uvicorn app.main:app --reload --port 8000",
      "options": {
        "cwd": "${workspaceFolder}/Version1/backend"
      },
      "isBackground": true,
      "problemMatcher": []
    },
    {
      "label": "Run Version1 Full Stack",
      "dependsOn": [
        "Version1: Frontend dev",
        "Version1: Backend dev"
      ],
      "dependsOrder": "parallel",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    }
  ]
}
