        <mxCell id="xss" value="&lt;b&gt;Stored or reflected XSS&lt;/b&gt;&lt;br&gt;&lt;br&gt;HTML sanitization, CSP, context-aware escaping" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
