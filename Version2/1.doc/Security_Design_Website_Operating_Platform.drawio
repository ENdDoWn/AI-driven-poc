        </mxCell>
        <mxCell id="identity" value="&lt;b&gt;2. Identity Security&lt;/b&gt;&lt;br&gt;JWT / session management&lt;br&gt;MFA&lt;br&gt;RBAC&lt;br&gt;Scope-aware access&lt;br&gt;Privileged access review" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="920" y="120" width="340" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="app" value="&lt;b&gt;3. Application Security&lt;/b&gt;&lt;br&gt;Input validation&lt;br&gt;CSRF / CORS controls&lt;br&gt;Secure headers&lt;br&gt;State transition validation&lt;br&gt;Idempotency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9EFF8;strokeColor=#244B8A;fontColor=#163172;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
