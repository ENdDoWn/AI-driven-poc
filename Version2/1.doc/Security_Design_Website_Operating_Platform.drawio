          <mxGeometry x="70" y="210" width="300" height="180" as="geometry"/>
        </mxCell>
        <mxCell id="context" value="&lt;b&gt;Tenant Context Middleware&lt;/b&gt;&lt;br&gt;Resolve user membership&lt;br&gt;Validate tenant status&lt;br&gt;Validate organization relation&lt;br&gt;Attach tenant context" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="180" width="380" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="permission" value="&lt;b&gt;Permission + Scope Check&lt;/b&gt;&lt;br&gt;Role permission&lt;br&gt;Tenant / organization scope&lt;br&gt;Team / assigned record scope&lt;br&gt;Partner attribution" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="180" width="390" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="service" value="&lt;b&gt;Domain Service&lt;/b&gt;&lt;br&gt;Receives trusted tenant context&lt;br&gt;Validates ownership and state&lt;br&gt;Never accepts raw tenant override" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E9EFF8;strokeColor=#244B8A;fontColor=#163172;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1510" y="180" width="390" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="repo" value="&lt;b&gt;Tenant-aware Repository&lt;/b&gt;&lt;br&gt;Every query includes tenant_id&lt;br&gt;Composite unique keys&lt;br&gt;Scoped joins&lt;br&gt;Scoped cache keys" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="2010" y="180" width="300" height="230" as="geometry"/>
        </mxCell>
        <mxCell id="db" value="&lt;b&gt;Transactional Database&lt;/b&gt;&lt;br&gt;tenant_id on customer data&lt;br&gt;Optional DB row policies&lt;br&gt;Foreign keys include tenant scope where practical" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
