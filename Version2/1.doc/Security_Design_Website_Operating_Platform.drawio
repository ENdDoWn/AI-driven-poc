        <mxCell id="actors" value="&lt;b&gt;Users &amp; External Systems&lt;/b&gt;&lt;br&gt;Internal Staff&lt;br&gt;Customers&lt;br&gt;Partners&lt;br&gt;Public Visitors&lt;br&gt;Payment / AI / DNS Providers" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F68C2C;fontColor=#7C2D12;fontStyle=1;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
