        <mxCell id="edge" value="&lt;b&gt;1. Edge Security&lt;/b&gt;&lt;br&gt;DNS security&lt;br&gt;CDN / WAF&lt;br&gt;DDoS protection&lt;br&gt;TLS 1.2+&lt;br&gt;Bot and rate controls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
