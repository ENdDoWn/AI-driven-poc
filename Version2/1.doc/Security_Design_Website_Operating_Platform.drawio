        </mxCell>
        <mxCell id="upload" value="&lt;b&gt;Malicious file upload&lt;/b&gt;&lt;br&gt;&lt;br&gt;Allowlist, scan, checksum, private storage, safe download" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="830" y="340" width="600" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="secrets" value="&lt;b&gt;Secret leakage&lt;/b&gt;&lt;br&gt;&lt;br&gt;Secrets manager, scanning, rotation, environment separation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
