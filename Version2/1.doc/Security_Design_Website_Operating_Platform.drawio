        </mxCell>
        <mxCell id="token" value="&lt;b&gt;Public token abuse&lt;/b&gt;&lt;br&gt;&lt;br&gt;High entropy, expiration, single purpose, rate limit, optional OTP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
