  <diagram id="7ae37411-806a-44f9-9280-c4670a783f34" name="3. Tenant Isolation">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1600" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Multi-tenant Isolation and Data Scope Enforcement" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#163172;strokeColor=#163172;fontColor=#ffffff;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="2250" height="55" as="geometry"/>
