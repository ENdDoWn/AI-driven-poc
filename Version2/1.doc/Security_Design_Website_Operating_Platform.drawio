          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="principles" value="&lt;b&gt;Core security principles&lt;/b&gt;&lt;br&gt;• Zero trust between layers&lt;br&gt;• Deny by default&lt;br&gt;• Verify identity, role and scope on every request&lt;br&gt;• Immutable audit trail for critical actions&lt;br&gt;• Published and financial records are immutable&lt;br&gt;• Security controls must exist server-side, not only in UI" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
