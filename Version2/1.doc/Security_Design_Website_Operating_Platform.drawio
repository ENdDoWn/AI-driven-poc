        </mxCell>
        <mxCell id="billing" value="&lt;b&gt;Billing or refund abuse&lt;/b&gt;&lt;br&gt;&lt;br&gt;Idempotency, approval, SoD, immutable finance records" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="80" y="910" width="600" height="140" as="geometry"/>
        </mxCell>
        <mxCell id="webhook" value="&lt;b&gt;Forged provider webhook&lt;/b&gt;&lt;br&gt;&lt;br&gt;Signature verification, timestamp tolerance, event deduplication" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
