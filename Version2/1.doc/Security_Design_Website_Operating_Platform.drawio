        </mxCell>
        <mxCell id="risknote" value="&lt;b&gt;Risk handling&lt;/b&gt;&lt;br&gt;Each material threat should have an owner, likelihood, impact, control, residual risk and review date. Security exceptions require documented approval and expiry." style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
