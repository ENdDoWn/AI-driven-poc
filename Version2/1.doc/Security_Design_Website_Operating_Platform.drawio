        </mxCell>
        <mxCell id="triage" value="&lt;b&gt;2. Triage&lt;/b&gt;&lt;br&gt;Validate signal&lt;br&gt;Identify tenant/users&lt;br&gt;Classify severity" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#475569;fontColor=#1E293B;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="430" y="210" width="280" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="ir1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;" edge="1" parent="1" source="detect" target="triage">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="contain" value="&lt;b&gt;3. Contain&lt;/b&gt;&lt;br&gt;Revoke sessions&lt;br&gt;Block IP/token&lt;br&gt;Disable integration&lt;br&gt;Suspend action" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="780" y="210" width="280" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="ir2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;" edge="1" parent="1" source="triage" target="contain">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="eradicate" value="&lt;b&gt;4. Eradicate&lt;/b&gt;&lt;br&gt;Patch issue&lt;br&gt;Rotate secrets&lt;br&gt;Remove malicious data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1130" y="210" width="280" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="ir3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;" edge="1" parent="1" source="contain" target="eradicate">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="recover" value="&lt;b&gt;5. Recover&lt;/b&gt;&lt;br&gt;Restore services&lt;br&gt;Validate integrity&lt;br&gt;Monitor closely" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#475569;fontColor=#1E293B;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1480" y="210" width="280" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="ir4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;" edge="1" parent="1" source="eradicate" target="recover">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="review" value="&lt;b&gt;6. Review&lt;/b&gt;&lt;br&gt;Root cause&lt;br&gt;Customer impact&lt;br&gt;Corrective actions&lt;br&gt;Post-incident report" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#475569;fontColor=#1E293B;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1830" y="210" width="280" height="210" as="geometry"/>
        </mxCell>
        <mxCell id="ir5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#475569;fontSize=11;" edge="1" parent="1" source="recover" target="review">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="severity" value="&lt;b&gt;Severity model&lt;/b&gt;&lt;br&gt;SEV-1: Major data exposure or platform-wide compromise&lt;br&gt;SEV-2: Material tenant impact or privileged account compromise&lt;br&gt;SEV-3: Limited impact, contained vulnerability&lt;br&gt;SEV-4: Low-risk event or false positive" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="620" width="560" height="260" as="geometry"/>
        </mxCell>
        <mxCell id="playbooks" value="&lt;b&gt;Required playbooks&lt;/b&gt;&lt;br&gt;• Account takeover&lt;br&gt;• Cross-tenant access&lt;br&gt;• Payment webhook compromise&lt;br&gt;• Secret leakage&lt;br&gt;• Malicious upload&lt;br&gt;• Unauthorized deployment&lt;br&gt;• Data loss / restore&lt;br&gt;• Third-party provider outage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;fontColor=#0C4A6E;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="830" y="620" width="560" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="evidence" value="&lt;b&gt;Evidence and communication&lt;/b&gt;&lt;br&gt;Preserve logs and request IDs&lt;br&gt;Record timeline and decisions&lt;br&gt;Restrict evidence access&lt;br&gt;Notify affected stakeholders&lt;br&gt;Publish status updates when appropriate&lt;br&gt;Track corrective actions to closure" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;fontColor=#065F46;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1560" y="620" width="560" height="300" as="geometry"/>
        </mxCell>
        <mxCell id="monitor" value="&lt;b&gt;Monitoring signals&lt;/b&gt;&lt;br&gt;Failed login rate&lt;br&gt;MFA reset activity&lt;br&gt;403 / tenant mismatch rate&lt;br&gt;Refund and role-change anomalies&lt;br&gt;Webhook validation failures&lt;br&gt;Deployment / rollback failures&lt;br&gt;Backup and restore failures" style="shape=note;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#78350F;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="100" y="1050" width="2020" height="220" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
