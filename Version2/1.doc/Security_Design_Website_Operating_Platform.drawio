        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Security Monitoring and Incident Response" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#163172;strokeColor=#163172;fontColor=#ffffff;fontStyle=1;fontSize=20;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="20" width="2250" height="55" as="geometry"/>
        </mxCell>
        <mxCell id="detect" value="&lt;b&gt;1. Detect&lt;/b&gt;&lt;br&gt;WAF alert&lt;br&gt;Login anomaly&lt;br&gt;Error spike&lt;br&gt;Audit anomaly&lt;br&gt;Provider alert" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#475569;fontColor=#1E293B;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
