        </mxCell>
        <mxCell id="tenant" value="&lt;b&gt;4. Tenant Isolation&lt;/b&gt;&lt;br&gt;Tenant context&lt;br&gt;Row-level filters&lt;br&gt;Ownership checks&lt;br&gt;No cross-tenant cache keys&lt;br&gt;Scoped file storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1760" y="120" width="340" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="data" value="&lt;b&gt;5. Data Security&lt;/b&gt;&lt;br&gt;Encryption in transit / at rest&lt;br&gt;Secrets management&lt;br&gt;Backups / PITR&lt;br&gt;Retention / deletion rules&lt;br&gt;PII minimization" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="500" y="500" width="340" height="220" as="geometry"/>
        </mxCell>
        <mxCell id="ops" value="&lt;b&gt;6. Operational Security&lt;/b&gt;&lt;br&gt;Central logs&lt;br&gt;Audit events&lt;br&gt;Alerts&lt;br&gt;Incident response&lt;br&gt;Backup restore tests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#475569;fontColor=#1E293B;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
