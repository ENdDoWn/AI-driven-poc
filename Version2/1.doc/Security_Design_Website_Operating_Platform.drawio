        </mxCell>
        <mxCell id="injection" value="&lt;b&gt;Injection / unsafe input&lt;/b&gt;&lt;br&gt;&lt;br&gt;Schema validation, parameterized queries, output encoding" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1">
